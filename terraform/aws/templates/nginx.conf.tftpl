load_module /usr/lib/nginx/modules/ngx_http_acme_module.so;
%{ if test_login_enabled ~}
load_module /usr/lib/nginx/modules/ngx_http_js_module.so;
%{ endif ~}
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  server_tokens off;
  sendfile on;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  # Match the normalized routing URI; named auth error redirects preserve it.
  map_hash_bucket_size 512;
  map $uri $api_cors_request_origin {
    default "";
    ~^/api(?:/|$) $http_origin;
  }
  map $api_cors_request_origin $api_cors_allow_origin {
    default "";
%{ for origin in cors_allowed_origins ~}
    "${origin}" "${origin}";
%{ endfor ~}
  }
  map $api_cors_allow_origin $api_cors_credentials {
    default "true";
    "" "";
  }
  map $uri $api_cors_vary {
    default "";
    ~^/api(?:/|$) "Origin";
  }
  map $api_cors_allow_origin $api_cors_rejected_origin {
    default "";
    "" $api_cors_request_origin;
  }

  # Amazon-provided DNS is also reachable from the web container.
  resolver 169.254.169.253 ipv6=off valid=300s;
  acme_issuer letsencrypt {
    uri https://acme-v02.api.letsencrypt.org/directory;
    challenge http-01;
    state_path /var/cache/nginx/acme;
    ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    accept_terms_of_service;
  }

%{ if test_login_enabled ~}
  js_engine qjs;
  js_import test_login from /etc/nginx/test-login.js;
%{ endif ~}

  server {
    listen 8080;
    server_name ${hostname};
    location / { return 308 https://${hostname}$request_uri; }
  }

  server {
    listen 8443 ssl;
    http2 on;
    server_name ${hostname};
    acme_certificate letsencrypt;
    ssl_certificate $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    ssl_certificate_cache max=2;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/openstudy/current;

    # Preserve server headers when locations add cache or preflight headers.
    # Empty map values omit CORS headers from non-API responses.
    add_header_inherit merge;
    add_header Access-Control-Allow-Origin $api_cors_allow_origin always;
    add_header Access-Control-Allow-Credentials $api_cors_credentials always;
    add_header Vary $api_cors_vary always;
    if ($api_cors_rejected_origin) { return 403; }

%{ if test_login_enabled ~}
    location = /api/test-login {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Methods "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, Authorization, Content-Type, X-CSRF-Token, X-Requested-With" always;
        add_header Access-Control-Max-Age 600 always;
        return 204;
      }
      auth_basic "OpenStudy test login";
      auth_basic_user_file /etc/nginx/auth/htpasswd;
      add_header Cache-Control no-store always;
      error_page 401 = @test_login_denied;
      js_content test_login.success;
    }
    location @test_login_denied {
      add_header Cache-Control no-store always;
      js_header_filter test_login.stripChallenge;
      js_content test_login.denied;
    }
%{ endif ~}

    location ~ ^/api(?:/|$) {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Methods "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, Authorization, Content-Type, X-CSRF-Token, X-Requested-With" always;
        add_header Access-Control-Max-Age 600 always;
        return 204;
      }
%{ if backend_enabled ~}
      # Nginx owns CORS so upstream headers cannot produce duplicate policies.
      proxy_hide_header Access-Control-Allow-Origin;
      proxy_hide_header Access-Control-Allow-Credentials;
      proxy_hide_header Access-Control-Allow-Methods;
      proxy_hide_header Access-Control-Allow-Headers;
      proxy_hide_header Access-Control-Max-Age;
      proxy_pass http://host.docker.internal:8081;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Connection "";
      proxy_buffering off;
      proxy_read_timeout 300s;
%{ else ~}
      default_type application/json;
      return 503 '{"message":"Backend origin is not configured."}';
%{ endif ~}
    }
    location ^~ /assets/ {
      root /srv/openstudy;
      add_header Cache-Control "public, max-age=31536000, immutable";
      try_files $uri =404;
    }
    location ~ \.[^/]+$ {
      add_header Cache-Control no-cache;
      try_files $uri =404;
    }
    location / {
      add_header Cache-Control no-cache;
      try_files $uri /index.html;
    }
  }
}
