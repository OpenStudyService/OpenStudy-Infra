#!/bin/bash
set -euo pipefail
umask 077

dnf upgrade --security --releasever=latest -y
dnf install -y docker git jq chrony awscli-2 python3
dnf install -y 'https://github.com/cloudflare/cloudflared/releases/download/${cloudflared_version}/cloudflared-linux-${rpm_arch}.rpm'

timedatectl set-timezone Asia/Seoul
systemctl enable --now chronyd amazon-ssm-agent

if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=${swap_size_mib} status=none
  chmod 600 /swapfile
  mkswap /swapfile
fi
if ! swapon --show=NAME --noheadings | grep -Fxq /swapfile; then
  swapon /swapfile
fi
if ! grep -q '^/swapfile[[:space:]]' /etc/fstab; then
  printf '/swapfile none swap sw 0 0\n' >> /etc/fstab
fi
printf 'vm.swappiness=10\n' > /etc/sysctl.d/99-openstudy.conf
sysctl --system

install -d -m 0755 /etc/docker /opt/openstudy
install -d -m 0700 /etc/openstudy
cat > /etc/docker/daemon.json <<'DOCKER'
{
  "log-driver": "local",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DOCKER
systemctl enable --now docker
systemctl disable --now sshd

cat > /usr/local/sbin/openstudy-cloudflared <<'RUNNER'
#!/bin/bash
set -euo pipefail
umask 077
/usr/bin/aws ssm get-parameter \
  --region '${aws_region}' \
  --name '${token_path}' \
  --with-decryption \
  --query Parameter.Value \
  --output text > /run/openstudy-cloudflared/token
test -s /run/openstudy-cloudflared/token
exec /usr/bin/cloudflared tunnel --no-autoupdate run \
  --token-file /run/openstudy-cloudflared/token
RUNNER
chmod 0750 /usr/local/sbin/openstudy-cloudflared

cat > /etc/systemd/system/cloudflared.service <<'UNIT'
[Unit]
Description=OpenStudy Cloudflare Tunnel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=openstudy-cloudflared
RuntimeDirectoryMode=0700
ExecStart=/usr/local/sbin/openstudy-cloudflared
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now cloudflared

%{ if enable_duckdns ~}
cat > /usr/local/sbin/openstudy-duckdns-update.py <<'DUCKDNS_PY'
${duckdns_update_script}
DUCKDNS_PY
chmod 0750 /usr/local/sbin/openstudy-duckdns-update.py

cat > /etc/systemd/system/openstudy-duckdns.service <<'DUCKDNS_UNIT'
[Unit]
Description=Update DuckDNS from EC2 public IPv4
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=AWS_DEFAULT_REGION=${aws_region}
Environment=DUCKDNS_TOKEN_PARAMETER=${duckdns_path}
Environment=DUCKDNS_SUBDOMAIN=${duckdns_subdomain}
StateDirectory=openstudy-duckdns
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/sbin/openstudy-duckdns-update.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
DUCKDNS_UNIT

cat > /etc/systemd/system/openstudy-duckdns.timer <<'DUCKDNS_TIMER'
[Unit]
Description=Check EC2 public IPv4 for DuckDNS updates

[Timer]
OnBootSec=1min
OnUnitActiveSec=15min
RandomizedDelaySec=30
Unit=openstudy-duckdns.service

[Install]
WantedBy=timers.target
DUCKDNS_TIMER

systemctl daemon-reload
systemctl enable --now openstudy-duckdns.timer
%{ else ~}
if systemctl cat openstudy-duckdns.timer >/dev/null 2>&1; then
  systemctl disable --now openstudy-duckdns.timer
  systemctl stop openstudy-duckdns.service
fi
%{ endif ~}

%{ if enable_frontend ~}
install -d -m 0755 /srv/openstudy /srv/openstudy/releases /srv/openstudy/assets
install -d -m 0700 /var/lib/openstudy-caddy/data /var/lib/openstudy-caddy/config
cat > /etc/openstudy/Caddyfile <<'CADDYFILE'
${frontend_caddyfile}
CADDYFILE
chmod 0644 /etc/openstudy/Caddyfile

# DNS must point at this instance before the ACME certificate checks begin.
systemctl start openstudy-duckdns.service
docker pull '${frontend_caddy_image}'
docker run --rm --entrypoint caddy \
  -v /etc/openstudy/Caddyfile:/etc/caddy/Caddyfile:ro \
  '${frontend_caddy_image}' validate --config /etc/caddy/Caddyfile --adapter caddyfile

cat > /etc/systemd/system/openstudy-web.service <<'WEB_UNIT'
[Unit]
Description=OpenStudy DuckDNS HTTPS static website
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f openstudy-web
ExecStart=/usr/bin/docker run --rm --name openstudy-web --network host --read-only --cap-drop ALL --cap-add NET_BIND_SERVICE --security-opt no-new-privileges --tmpfs /tmp:size=16m -v /etc/openstudy/Caddyfile:/etc/caddy/Caddyfile:ro -v /srv/openstudy:/srv/openstudy:ro -v /var/lib/openstudy-caddy/data:/data -v /var/lib/openstudy-caddy/config:/config ${frontend_caddy_image}
ExecStop=/usr/bin/docker stop -t 10 openstudy-web
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
WEB_UNIT
systemctl daemon-reload
systemctl enable openstudy-web
systemctl restart openstudy-web
%{ else ~}
if systemctl cat openstudy-web.service >/dev/null 2>&1; then
  systemctl disable --now openstudy-web.service
fi
%{ endif ~}
