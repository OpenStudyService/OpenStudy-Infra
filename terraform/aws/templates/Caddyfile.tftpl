{
  admin off
}

${hostname} {
  root * /srv/openstudy/current
  encode zstd gzip

  @api path /api /api/*
  handle @api {
    header Content-Type application/json
    respond `{"message":"Backend origin is not configured."}` 503
  }

  @assets path /assets/*
  handle @assets {
    root * /srv/openstudy
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  @files path_regexp files \.[^/]+$
  handle @files {
    header Cache-Control no-cache
    file_server
  }

  handle {
    try_files {path} /index.html
    header Cache-Control no-cache
    file_server
  }
}
