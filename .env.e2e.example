# Copy to .env.e2e.local. Use a dedicated test account on the intended deployment.
# HTTPS is required except on a loopback development server.
E2E_BASE_URL=https://openstudy.duckdns.org
E2E_EMAIL=
E2E_PASSWORD=
# Optional: require the installed embedding model without calling the LLM.
E2E_REQUIRE_AI=false
